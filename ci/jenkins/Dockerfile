# Jenkins controller for the kazner pipeline: Jenkins LTS + Docker CLI + kubectl + plugins,
# configured by Configuration-as-Code (casc.yaml). Started by ci/jenkins/compose.yaml.

FROM docker:28.4.0-cli AS dockercli

FROM jenkins/jenkins:2.580.1-lts-jdk21
USER root
# Docker CLI and buildx talk to the host engine through the mounted socket.
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=dockercli /usr/local/libexec/docker/cli-plugins/docker-buildx /usr/local/libexec/docker/cli-plugins/docker-buildx
# kubectl at the same minor version as Docker Desktop's Kubernetes, checksum-verified.
ARG KUBECTL_VERSION=v1.34.1
RUN curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
    && curl -fsSLo /tmp/kubectl.sha256 "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl.sha256" \
    && echo "$(cat /tmp/kubectl.sha256)  /usr/local/bin/kubectl" | sha256sum --check \
    && chmod +x /usr/local/bin/kubectl && rm /tmp/kubectl.sha256
USER jenkins
ENV JAVA_OPTS="-Djenkins.install.runSetupWizard=false" \
    CASC_JENKINS_CONFIG=/usr/share/jenkins/ref/casc.yaml
COPY --chown=jenkins:jenkins plugins.txt /usr/share/jenkins/ref/plugins.txt
RUN jenkins-plugin-cli --plugin-file /usr/share/jenkins/ref/plugins.txt
COPY --chown=jenkins:jenkins casc.yaml /usr/share/jenkins/ref/casc.yaml
