# Copy to ci/jenkins/.env (ignored by git) and fill in.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=
# Optional: Docker Hub repository for the push stage, e.g. yourname/kazner.
# Also add a "Username with password" credential with ID "dockerhub" in Jenkins
# (Docker Hub user name + an access token, not the account password).
DOCKERHUB_REPO=
